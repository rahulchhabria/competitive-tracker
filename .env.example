# AI Provider Configuration
# Choose one or more providers

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI (GPT)
OPENAI_API_KEY=your_openai_key_here

# Data Storage
DATA_DIR=./data

# Analysis Configuration
DEFAULT_MODEL=anthropic:claude-sonnet-4-20250514
ANALYSIS_TEMPERATURE=0.3
MAX_TOKENS=4000

# Digest Settings
DIGEST_FREQUENCY=weekly
# Where to save generated digest markdown files (supports ~ for home directory)
# Examples: ~/Documents/Competitive Digests, /Users/you/Desktop/Digests, ./exports
DIGEST_OUTPUT_DIR=~/Documents/Competitive Digests
THREAT_LEVELS=critical,high,medium,low
PRODUCT_AREAS=core,integrations,pricing,marketing
